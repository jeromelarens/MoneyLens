# ==============================================================================
# MoneyLens Backend API Environment Template (apps/api)
# ==============================================================================
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/moneylens?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GEMINI_API_KEY=
