# ==============================================================================
# MoneyLens Production & Development Environment Configuration Template
# ==============================================================================
# This template documents all environment variables used across the MoneyLens
# monorepo (apps/api, apps/web, and packages/shared).
#
# DO NOT COMMIT ACTUAL SECRETS, CREDENTIALS, OR LIVE CONNECTION STRINGS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Runtime & HTTP Configuration (apps/api)
# ------------------------------------------------------------------------------

# Application runtime environment ('development' | 'production' | 'test').
# In 'production':
#   - Developer authentication bypass is strictly disabled.
#   - Wildcard CORS origins are forbidden.
#   - Mongoose autoIndex is disabled (run index migration scripts beforehand).
#   - Helmet Content Security Policy is enforced.
NODE_ENV=development

# Port on which the API HTTP listener binds (1024 - 65535).
PORT=4000

# Primary MongoDB Connection URI (REQUIRED, SECRET).
# Accepted schemes: mongodb:// or mongodb+srv://
# Production requirement: Multi-node Replica Set (Atlas or self-hosted) with TLS.
# Example local: mongodb://127.0.0.1:27017/moneylens_dev
# Example production placeholder:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/moneylens?retryWrites=true&w=majority

# Logging level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'.
# Default: 'info' in development/production, 'silent' in test.
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & Security Origin Boundaries (apps/api)
# ------------------------------------------------------------------------------

# Allowed Frontend Origins for credentialed CORS access.
# May be a single URL or comma-separated list of origins.
# In 'production', wildcard '*' is strictly prohibited when credentials are enabled.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate Limiting Configuration (apps/api)
# Window size in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 3. Optional Applied AI / Explainability Engine (apps/api)
# ------------------------------------------------------------------------------

# Google Gemini API Key (OPTIONAL, SECRET).
# If omitted or invalid, the system automatically falls back to deterministic,
# rule-based financial explanations with 100% feature availability and zero downtime.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Frontend Client Configuration (apps/web)
# ------------------------------------------------------------------------------
# NOTE: Variables prefixed with VITE_ are bundled into client-side JavaScript
# and are publicly visible in browser assets. NEVER PUT SECRETS IN VITE_ VARIABLES.

# Target Backend REST API base URL.
VITE_API_URL=http://localhost:4000/api/v1

# Optional Development Sandbox API Key Override for local frontend testing.
# In production builds, this must be omitted or empty.
VITE_API_KEY=
